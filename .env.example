# Copy to .env (docker compose reads it automatically) and set both to
# require this username/password (HTTP Basic Auth) for the web UI and the
# embedded Chrome login behind it.
# Leave blank/unset to run without auth (trusted LAN only).
HTTP_USER=
HTTP_PASSWORD=

# Enables an extra, optional query for live battery/WiFi status per locate
# (phones only) - off by default. Also makes the next "Sign in with Google"
# capture the browser session cookie it needs; still has to be turned on per
# device/endpoint too (Forwarding Settings page). See Auth/live_device_info.py.
ENABLE_LIVE_DEVICE_INFO=0
