# Copy to .env (docker compose reads it automatically) and set both to
# require this username/password (HTTP Basic Auth) for the web UI and the
# embedded Chrome login behind it.
# Leave blank/unset to run without auth (trusted LAN only).
HTTP_USER=
HTTP_PASSWORD=

# Any string - when set, encrypts every value in Auth/auth.yaml at rest
# (AES-256-GCM) instead of storing them as plain text. Leave blank/unset to
# keep the old plain-text behavior; a warning is logged once on startup when
# it's unset. Changing/losing this makes existing encrypted values unreadable.
SECRETS_ENCRYPTION_KEY=

# Set to 1 to serve HTTPS instead of HTTP on the same port, using a
# self-signed certificate generated automatically on first start and reused
# after that. Leave blank/unset for plain HTTP. See the README's Security
# section before turning this on.
HTTPS_ENABLED=
# Optional: extra hostnames/IPs (comma-separated) to add to the generated
# cert, if you reach this box by a LAN hostname or static IP rather than
# just localhost.
# GFMT_TLS_SAN=my-nas.local,192.168.1.50
